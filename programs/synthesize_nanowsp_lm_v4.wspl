experiment synthesize_nanowsp_lm_v4:
    model: nanoGPT
    objective: associative_context_language_prediction
    budgets:
        max_modified_weights = 20000000
        allow_write = true
        allow_training = true
    steps:
        step synthesize method=structured_ridge_v4 arch=programs/arch/nanowsp_lm.wsparch data=lab/data/shakespeare_char/input.txt out=models/nanowsp_lm_v4/model.safetensors seed=1337 device=cpu
