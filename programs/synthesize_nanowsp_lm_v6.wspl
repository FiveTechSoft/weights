experiment synthesize_nanowsp_lm_v6:
    model: nanoGPT
    objective: distributed_spectral_language_prediction
    budgets:
        max_modified_weights = 4000000
        allow_write = true
        allow_training = true
    steps:
        step synthesize method=spectral_v6 arch=programs/arch/nanowsp_lm.wsparch data=lab/data/shakespeare_char/input.txt out=models/nanowsp_lm_v6/model.safetensors seed=1337
