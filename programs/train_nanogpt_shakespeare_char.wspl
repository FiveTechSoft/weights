# ==============================================================================
# WSP-Lang: train nanoGPT on Shakespeare char, with the config of karpathy/nanoGPT
# config/train_shakespeare_char.py. Control run: gradient descent, not synthesis.
# Upstream reports a best validation loss of 1.4697 with this configuration.
# ==============================================================================

experiment train_nanogpt_shakespeare_char:
    model: nanoGPT
    objective: reproduce_upstream_validation_loss_by_gradient_descent

    budgets:
        max_modified_weights = 11000000
        allow_write = true
        allow_training = true

    steps:
        step train arch=programs/arch/nanogpt.wsparch data=lab/data/shakespeare_char/input.txt out=models/nanogpt_shakespeare_char/model.safetensors seed=1337 bias=false dropout=0.2 device=cuda batch_size=64 gradient_accumulation_steps=1 max_iters=5000 eval_interval=250 eval_iters=200 log_interval=100 always_save_checkpoint=false learning_rate=1e-3 min_lr=1e-4 beta2=0.99 warmup_iters=100 lr_decay_iters=5000
