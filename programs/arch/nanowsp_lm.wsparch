# NanoWSP-LM: a 4-layer bias-free nanoGPT (karpathy/nanoGPT@3adf61e layout) declared as data.
# bias = false here, not as a train override, so build_nanowsp_lm (W0) and train_nanowsp_lm start
# from the same parameters with the same seed. The first init pass is what torch does when
# building nn.Linear/nn.Embedding; the weights depend on those draws through the RNG stream.

arch nanowsp_lm:
    config:
        vocab = 65
        block = 256
        layers = 4
        heads = 4
        d = 256
        ff = 4 * d
        dropout = 0.0
        bias = false

    graph(idx):
        scope transformer:
            tok = embedding(wte, idx, vocab, d)
            where = positions(idx)
            pos = embedding(wpe, where, block, d)
            x = add(tok, pos)
            x = dropout(x, dropout)
            repeat i in layers:
                scope h.{i}:
                    a = layernorm(ln_1, x, d, bias)
                    scope attn:
                        qkv = linear(c_attn, a, d, 3 * d, bias)
                        q, k, v = split(qkv, 3)
                        y = causal_attention(q, k, v, heads, dropout)
                        y = linear(c_proj, y, d, d, bias)
                        y = dropout(y, dropout)
                    x = add(x, y)
                    m = layernorm(ln_2, x, d, bias)
                    scope mlp:
                        m = linear(c_fc, m, d, ff, bias)
                        m = gelu(m)
                        m = linear(c_proj, m, ff, d, bias)
                        m = dropout(m, dropout)
                    x = add(x, m)
            x = layernorm(ln_f, x, d, bias)
        logits = linear(lm_head, x, d, vocab, false)
        output logits

    init:
        pass:
            embedding.weight = normal(0, 1)
            linear.weight = kaiming_uniform(sqrt(5))
            linear.bias = fan_in_uniform()
            layernorm.weight = ones()
            layernorm.bias = zeros()
        tie transformer.wte.weight = lm_head.weight
        pass:
            embedding.weight = normal(0, 0.02)
            linear.weight = normal(0, 0.02)
            linear.bias = zeros()
        pass:
            match "*c_proj.weight" = normal(0, 0.02 / sqrt(2 * layers))
