experiment synthesize_nanowsp_lm_v5_table:
    model: nanoGPT
    objective: expanded_context_language_prediction
    budgets:
        max_modified_weights = 60000000
        allow_write = true
        allow_training = true
    steps:
        step synthesize method=structured_table_v5 arch=programs/arch/nanowsp_lm.wsparch data=lab/data/shakespeare_char/input.txt out=models/nanowsp_lm_v5_table/model.safetensors seed=1337 device=cpu
