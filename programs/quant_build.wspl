experiment quant_build:
objective: three 2-bit GGUFs for lab/probes/quantize/PLAN.md (requantised from Q6_K; IQ2 with an importance matrix on WikiText-2 train)
steps:
    step quantize model=hf_cache/h4/A0-Q6_K.gguf type=Q2_K allow_requantize=true out=hf_cache/quant/qwen9b-Q2_K.gguf
    step quantize model=hf_cache/h4/A0-Q6_K.gguf type=IQ2_XS imatrix=auto allow_requantize=true out=hf_cache/quant/qwen9b-IQ2_XS.gguf
    step quantize model=hf_cache/cc_op_v2/merged-Q6_K.gguf type=IQ2_XS imatrix=auto allow_requantize=true out=hf_cache/quant/compiled-IQ2_XS.gguf
